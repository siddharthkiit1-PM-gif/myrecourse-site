---
import Base from "../layouts/Base.astro";

const APP_URL = "https://rental-recourse.vercel.app";

const groups = [
  {
    label: "§01",
    title: "The product",
    items: [
      {
        q: "Is the free draft actually free?",
        a: "Yes. Drafting and downloading the notice as a PDF costs nothing — no paywall, no signup, no card on file. The ₹499 stamp is an entirely optional add-on: an advocate reviews, redlines, and signs a sealed version. Draft first, decide about the stamp on the results page.",
      },
      {
        q: "What's the difference between the draft and the stamp?",
        a: "The draft is machine-assembled from your inputs and verbatim state-law citations. The stamped version has been read and signed by a Bar Council–enrolled advocate on the marketplace, on their letterhead, with their roll number. Same words most of the time — one is your letter, the other is an advocate's.",
      },
      {
        q: "Is a drafted notice on its own legally valid?",
        a: "Yes. A legal notice is any written demand identifying the dispute and the remedy sought. You do not need a lawyer's letterhead to send one. What the stamp adds is credibility with landlords, insurance for citation accuracy, and a real name on the line.",
      },
      {
        q: "Can I edit the notice before I download or stamp it?",
        a: "Yes. Every field in the draft is inline-editable. Rewrite paragraphs, change dates, add facts, remove sections. The PDF export and the stamp request both reflect your edits.",
      },
    ],
  },
  {
    label: "§02",
    title: "The stamp",
    items: [
      {
        q: "Who stamps my notice?",
        a: "A Bar Council–enrolled advocate on the Recourse marketplace, in rolling onboarding batches. They see your draft, redline it against their reading of your facts, and sign the sealed PDF on their letterhead with their state Bar roll number visible.",
      },
      {
        q: "How long does the stamp take?",
        a: "Within 48 hours of your request in normal conditions. Once picked up, most files close the same working day.",
      },
      {
        q: "Why ₹499?",
        a: "It's the price a private advocate would charge to redline a draft, not to write one from scratch. Because we do the drafting, the advocate is paid to verify — which is where the value is, and why it can be a fifth of the going rate.",
      },
      {
        q: "Is the ₹499 refundable if the advocate flags a serious issue?",
        a: "Yes. If the advocate concludes your matter is materially different from what the draft assumed and should not be stamped as-is, you're refunded and given written guidance on next steps. This has happened in a small minority of files so far.",
      },
    ],
  },
  {
    label: "§03",
    title: "The marketplace",
    items: [
      {
        q: "You mention advisors — where are they?",
        a: "In onboarding. The advocate directory is opening in rolling batches. Right now, verified advocates work on stamp requests in the background; browseable profiles, availability, and direct booking come next. Join the waitlist on the Advisors page to be notified.",
      },
      {
        q: "I'm an advocate. How do I join?",
        a: "The advisors page has an application form. We need your name, state Bar roll number, and email; a member of the team will reach out within a week. See the 'For advocates' section for what the arrangement looks like.",
      },
      {
        q: "What services are coming after the stamped notice?",
        a: "General legal consulting on tenancy and consumer matters, filing your notice on your behalf (registered post + email), and advisory retainers — booked through the same marketplace. Timelines will be announced on this page.",
      },
    ],
  },
  {
    label: "§04",
    title: "Legality & data",
    items: [
      {
        q: "Is this legal advice?",
        a: "The draft on its own is not — Recourse is an informational drafting tool, not a law firm. Using the draft alone does not create an attorney–client relationship. Once you request the ₹499 stamp, the advocate who signs the sealed notice takes professional responsibility for that specific document.",
      },
      {
        q: "Is using AI to generate a legal notice allowed under Indian law?",
        a: "Drafting a document for your own use is not the practice of law. The Advocates Act §29 regulates who can appear before courts and hold themselves out as an advocate — not who can put words on paper about their own dispute. Recourse helps you write your own demand letter.",
      },
      {
        q: "What happens to my data?",
        a: "Unstamped session data expires in 24 hours. For stamped notices, the file is retained by the assigned advocate on their side for their professional record and by us for one year for dispute resolution. No email address is required for the draft; the stamp step needs one so the sealed PDF can reach you.",
      },
      {
        q: "My state isn't in the list. Can I still use it?",
        a: "Yes. Pick 'Other state' on intake and we draft using the Consumer Protection Act, the Indian Contract Act, and CPC §80 — statutes that apply anywhere in India for deposit disputes and contract breaches.",
      },
    ],
  },
  {
    label: "§05",
    title: "Meta",
    items: [
      {
        q: "Who built Recourse?",
        a: "Solo-built, launched August 2026. See the About page. The marketplace layer opened in September 2026 with the first advocate batch.",
      },
      {
        q: "I found a bug or the citation looks wrong. What do I do?",
        a: "Email hello@myrecourse.in with the section, the state, and what you expected. Citation issues get triaged first because they matter most.",
      },
    ],
  },
];
---

<Base
  title="FAQ — Recourse"
  description="Answers about Recourse: the free draft, the ₹499 advocate stamp, the marketplace of advisors, data handling, and what the notice is and isn't."
  headerVariant="paper"
>
  <!-- HERO -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 pt-16 md:pt-28 pb-12 md:pb-16">
    <div class="grid gap-8 md:grid-cols-12 items-end">
      <div class="md:col-span-9">
        <p class="eyebrow rise" style="animation-delay:0ms">§ Frequently asked</p>
        <h1 class="mt-6 font-display text-[46px] md:text-[76px] leading-[0.98] tracking-tight rise" style="animation-delay:60ms">
          Fair questions,
          <span class="italic text-[color:var(--color-ochre)]">direct</span> answers.
        </h1>
      </div>
      <div class="md:col-span-3 rise" style="animation-delay:140ms">
        <p class="text-[color:var(--color-ink-muted)] text-[15px] leading-relaxed">
          Nothing here? Write to
          <a href="mailto:hello@myrecourse.in" class="underline decoration-[color:var(--color-ochre)] underline-offset-4">hello@myrecourse.in</a>
          — a person replies within a working day.
        </p>
      </div>
    </div>
  </section>

  <!-- GROUPS -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 pb-16">
    <div class="space-y-14 md:space-y-20">
      {groups.map((group) => (
        <div data-reveal>
          <div class="grid gap-8 md:grid-cols-12 items-baseline pb-6 border-b border-[color:var(--color-ink)]">
            <div class="md:col-span-3 font-mono text-[11px] tracking-[0.18em] text-[color:var(--color-ochre-2)]">{group.label}</div>
            <h2 class="md:col-span-9 font-display text-3xl md:text-5xl leading-[1.02] tracking-tight">{group.title}</h2>
          </div>
          <div class="divide-y divide-[color:var(--color-hairline)]">
            {group.items.map((f) => (
              <details class="group py-6 md:py-8">
                <summary class="list-none cursor-pointer grid grid-cols-12 gap-6 items-start">
                  <h3 class="col-span-11 font-display text-2xl md:text-3xl leading-[1.15] tracking-tight text-[color:var(--color-ink)] group-open:text-[color:var(--color-ochre-2)] transition-colors">{f.q}</h3>
                  <span
                    class="col-span-1 justify-self-end mt-2 shrink-0 text-[color:var(--color-ink-faint)] group-open:rotate-45 group-open:text-[color:var(--color-ochre)] transition-all text-2xl leading-none font-display"
                    aria-hidden="true"
                  >+</span>
                </summary>
                <div class="mt-5 grid grid-cols-12 gap-6">
                  <p class="col-start-1 md:col-start-1 col-span-12 md:col-span-9 text-[16px] md:text-[17px] text-[color:var(--color-ink-muted)] leading-relaxed">{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 pb-24">
    <div class="border-t-2 border-[color:var(--color-ink)] pt-10 flex flex-col md:flex-row md:items-end md:justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">Still weighing it up</p>
        <h3 class="mt-4 font-display text-3xl md:text-5xl leading-[1.02] tracking-tight max-w-xl">
          The draft is <span class="italic text-[color:var(--color-ochre)]">free</span>. If it isn't useful, nothing lost.
        </h3>
      </div>
      <a href={`${APP_URL}/intake`} class="shrink-0 inline-flex items-center gap-2 h-12 px-6 bg-[color:var(--color-ink)] text-[color:var(--color-paper)] font-medium hover:opacity-90 transition-opacity">
        Draft my notice <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
