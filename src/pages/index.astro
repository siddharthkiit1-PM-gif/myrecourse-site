---
import Base from "../layouts/Base.astro";

const APP_URL = "https://rental-recourse.vercel.app";

const stats = [
  { n: "42", l: "advocates onboarding" },
  { n: "10", l: "state Rent Acts + national" },
  { n: "48h", l: "avg stamp turnaround" },
  { n: "100%", l: "Bar Council–enrolled" },
];

const services = [
  {
    tag: "Product",
    title: "Draft your notice",
    price: "Free",
    turn: "~30 s",
    body: "Six intake screens. The agent retrieves verbatim statute text from your state's Rent Act and drafts a demand notice. PDF export. No signup.",
    cta: { label: "Start drafting", href: `${APP_URL}/intake` },
    live: true,
    tone: "paper",
  },
  {
    tag: "Product",
    title: "Get it stamped",
    price: "₹499",
    turn: "48 h",
    body: "A Bar Council–enrolled advocate reads your draft, redlines it, and signs a sealed version onto their letterhead with their state roll number.",
    cta: { label: "See how the stamp works", href: "/notice/#stamp" },
    live: true,
    tone: "ochre",
  },
  {
    tag: "Marketplace",
    title: "Consult an advocate",
    price: "from ₹749",
    turn: "same day",
    body: "30-minute call with a verified advocate on tenancy, deposits, eviction, or a specific notice you've received. Booked directly through the directory.",
    cta: { label: "Join waitlist", href: "/advisors/#waitlist" },
    live: false,
    tone: "paper",
  },
  {
    tag: "Marketplace",
    title: "Retain for the month",
    price: "from ₹2,499",
    turn: "on demand",
    body: "An advocate on retainer for one calendar month — reply drafts, follow-ups, and one filed matter. Suited for active disputes.",
    cta: { label: "Join waitlist", href: "/advisors/#waitlist" },
    live: false,
    tone: "paper",
  },
];

const categories = [
  { k: "Deposit not returned", act: "State Rent Act · CPA §35" },
  { k: "Illegal eviction / lockout", act: "Rent Act · CrPC §441" },
  { k: "Rent hike beyond contract", act: "Rent Act · Contract Act §23" },
  { k: "Habitability & repairs", act: "Rent Act · Model Tenancy Act" },
  { k: "Society interference", act: "State Cooperative Act" },
  { k: "Broker fraud", act: "CPA · IPC §420" },
  { k: "Refusal to issue receipt", act: "Rent Act · IT Act §194-I" },
  { k: "Notice to quit received", act: "TP Act §106 reply" },
];

const advocates = [
  { init: "AR", name: "Anushka R.", city: "Bengaluru", state: "KA", roll: "KA / 2014", specs: ["Rentals", "Consumer"], files: 42, status: "verified", price: "₹499" },
  { init: "VS", name: "Vikram S.", city: "Delhi NCR", state: "DEL", roll: "DEL / 2009", specs: ["Property", "Commercial leases"], files: 61, status: "verified", price: "₹499" },
  { init: "FQ", name: "Farah Q.", city: "Mumbai", state: "MAH", roll: "MAH / 2016", specs: ["Rentals", "Society matters"], files: 9, status: "onboarding", price: "₹499" },
  { init: "RM", name: "Rohit M.", city: "Pune", state: "MAH", roll: "MAH / 2012", specs: ["Deposits", "Eviction"], files: 28, status: "verified", price: "₹499" },
  { init: "PK", name: "Priya K.", city: "Hyderabad", state: "TS", roll: "TS / 2011", specs: ["Rentals", "RERA"], files: 34, status: "verified", price: "₹499" },
  { init: "AB", name: "Arjun B.", city: "Chennai", state: "TN", roll: "TN / 2015", specs: ["Contracts", "Consumer"], files: 5, status: "onboarding", price: "₹499" },
];

const coverage = [
  { st: "Karnataka", cities: "Bengaluru · Mysuru · Mangaluru" },
  { st: "Maharashtra", cities: "Mumbai · Pune · Nagpur" },
  { st: "Delhi NCR", cities: "Delhi · Gurgaon · Noida" },
  { st: "Tamil Nadu", cities: "Chennai · Coimbatore" },
  { st: "Telangana", cities: "Hyderabad · Warangal" },
  { st: "West Bengal", cities: "Kolkata · Howrah" },
  { st: "Gujarat", cities: "Ahmedabad · Surat" },
  { st: "Uttar Pradesh", cities: "Lucknow · Noida · Kanpur" },
  { st: "Kerala", cities: "Kochi · Trivandrum" },
  { st: "Haryana", cities: "Gurgaon · Faridabad" },
];

const steps = [
  { n: "01", t: "Tell us what happened", d: "Six short intake screens — situation, tenant, landlord, property, evidence, jurisdiction. Around five minutes." },
  { n: "02", t: "Get the draft", d: "Verbatim statute retrieval + citation verifier. Around thirty seconds, in front of you." },
  { n: "03", t: "Stamp (optional)", d: "Advocate reviews and redlines. Signs your notice onto their letterhead. Under 48 hours." },
  { n: "04", t: "Send it", d: "India Post registered A/D or signed email. We can post it for you in Q4." },
];
---

<Base
  title="Recourse — a marketplace of legal advisors for Indian tenants"
  description="Draft a legal notice free, then get it stamped by a Bar Council–enrolled advocate for ₹499. Ten state Rent Acts covered. 48h turnaround."
  headerVariant="paper"
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-5 md:px-10 pt-10 md:pt-16 pb-16 md:pb-24">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pb-8 md:pb-12 rise" style="animation-delay:0ms">
        <span class="badge badge-verified"><span class="badge-dot"></span>Live · v0.9</span>
        <span class="mono-label">First 42 advocates onboarding</span>
        <span class="mono-label hidden md:inline">·</span>
        <span class="mono-label hidden md:inline">Batch 03 opens Oct 2026</span>
      </div>

      <div class="grid gap-10 md:gap-16 md:grid-cols-12 items-end">
        <div class="md:col-span-8">
          <p class="eyebrow rise" style="animation-delay:40ms">Legal infrastructure for Indian tenants</p>
          <h1 class="mt-5 font-display text-[46px] md:text-[76px] leading-[0.98] tracking-tight rise" style="animation-delay:100ms">
            A marketplace of legal advisors — starting with the notice your landlord will actually read.
          </h1>
          <p class="mt-6 md:mt-8 max-w-2xl text-[17px] md:text-lg text-[color:var(--color-ink-muted)] leading-relaxed rise" style="animation-delay:180ms">
            Draft a filing-ready legal notice in about thirty seconds, free. Have it verified and stamped by a Bar Council&ndash;enrolled advocate for ₹499, delivered in 48 hours. Consulting, filing, and advisory retainers open next.
          </p>

          <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-3 rise" style="animation-delay:260ms">
            <a href={`${APP_URL}/intake`} class="btn btn-primary">
              Draft your notice — free
              <span aria-hidden="true">→</span>
            </a>
            <a href="#advocates" class="btn btn-outline">Browse advocates</a>
            <span class="mono-label ml-1">No signup · No card</span>
          </div>
        </div>

        <aside class="md:col-span-4 rise" style="animation-delay:320ms">
          <div class="card p-6 md:p-7 relative">
            <div class="flex items-center justify-between">
              <span class="mono-label">§ Live counters</span>
              <span class="badge badge-onboarding">Batch 03</span>
            </div>
            <div class="mt-5 grid grid-cols-2 gap-x-4 gap-y-6">
              {stats.map((s) => (
                <div>
                  <div class="stat-num text-[42px] md:text-[46px] text-[color:var(--color-ink)]">{s.n}</div>
                  <div class="mt-1.5 text-[12px] leading-snug text-[color:var(--color-ink-muted)]">{s.l}</div>
                </div>
              ))}
            </div>
            <div class="mt-6 pt-4 border-t border-[color:var(--color-hairline)] flex items-center justify-between">
              <span class="mono-label">Turnaround</span>
              <span class="font-mono text-[12px] text-[color:var(--color-ink)]">Draft ~30 s · Stamp ≤ 48 h</span>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <div class="border-y border-[color:var(--color-hairline)] bg-[color:var(--color-cream)] overflow-hidden">
      <div class="flex whitespace-nowrap marquee-track py-3.5 font-mono text-[12px] uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">
        {Array.from({length: 2}).map(() => (
          <div class="flex items-center gap-8 pr-8 shrink-0">
            <span>§ Karnataka Rent Act 2001</span><span>·</span>
            <span>§ Maharashtra Rent Control 1999</span><span>·</span>
            <span>§ Delhi Rent Act 1995</span><span>·</span>
            <span>§ Tamil Nadu Rent Act 2017</span><span>·</span>
            <span>§ Telangana Rent Control 1960</span><span>·</span>
            <span>§ WB Premises Tenancy 1997</span><span>·</span>
            <span>§ Model Tenancy Act 2021</span><span>·</span>
            <span>§ CPC §80</span><span>·</span>
            <span>§ Consumer Protection Act 2019</span><span>·</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-28">
    <div class="grid gap-10 md:grid-cols-12 items-end" data-reveal>
      <div class="md:col-span-6">
        <p class="eyebrow">§ Start from your problem</p>
        <h2 class="mt-4 font-display text-4xl md:text-5xl leading-[1.02] tracking-tight">
          What is your landlord doing?
        </h2>
      </div>
      <p class="md:col-span-6 text-[color:var(--color-ink-muted)] leading-relaxed max-w-lg md:justify-self-end">
        Pick the situation closest to yours. The draft is routed to the correct forum (rent controller, consumer forum, RERA, or civil court) automatically.
      </p>
    </div>

    <div class="mt-12 grid gap-0 sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-[color:var(--color-hairline)]" data-reveal>
      {categories.map((c) => (
        <a
          href={`${APP_URL}/intake`}
          class="group relative p-6 border-r border-b border-[color:var(--color-hairline)] bg-[color:var(--color-paper)] hover:bg-[color:var(--color-cream)] transition-colors"
        >
          <div class="flex items-start justify-between gap-3">
            <p class="font-display text-xl md:text-[22px] leading-snug text-[color:var(--color-ink)]">{c.k}</p>
            <span
              class="mt-1 font-display text-xl text-[color:var(--color-ink-faint)] group-hover:text-[color:var(--color-ochre)] group-hover:translate-x-1 transition-all"
              aria-hidden="true"
            >→</span>
          </div>
          <p class="mt-6 mono-label">{c.act}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="bg-[color:var(--color-paper-2)] border-y border-[color:var(--color-hairline)]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-28">
      <div class="grid gap-10 md:grid-cols-12 items-end mb-14" data-reveal>
        <div class="md:col-span-7">
          <p class="eyebrow">§ Shelf</p>
          <h2 class="mt-4 font-display text-4xl md:text-5xl leading-[1.02] tracking-tight">
            Two products live. Two loading in.
          </h2>
        </div>
        <p class="md:col-span-5 text-[color:var(--color-ink-muted)] leading-relaxed md:justify-self-end max-w-md">
          Prices are transparent and fixed. The stamp is optional at every step — start with the free draft.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {services.map((s) => (
          <article class={`card p-6 md:p-7 flex flex-col ${s.tone === "ochre" ? "border-l-2 border-l-[color:var(--color-ochre)]" : ""}`}>
            <div class="flex items-center justify-between">
              <span class="mono-label">{s.tag}</span>
              {s.live ? <span class="badge badge-verified"><span class="badge-dot"></span>Live</span> : <span class="badge badge-onboarding">Coming</span>}
            </div>
            <h3 class="mt-6 font-display text-[26px] leading-tight text-[color:var(--color-ink)]">{s.title}</h3>
            <div class="mt-4 flex items-baseline gap-3 pb-4 border-b border-[color:var(--color-hairline)]">
              <span class="stat-num text-[34px] text-[color:var(--color-ink)]">{s.price}</span>
              <span class="mono-label">{s.turn}</span>
            </div>
            <p class="mt-4 text-[14.5px] text-[color:var(--color-ink-muted)] leading-relaxed flex-1">{s.body}</p>
            <a
              href={s.cta.href}
              class={`mt-6 btn btn-sm ${s.live && s.tone === "ochre" ? "btn-ochre" : s.live ? "btn-primary" : "btn-outline"}`}
            >
              {s.cta.label} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ADVOCATES -->
  <section id="advocates" class="max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-28">
    <div class="grid gap-10 md:grid-cols-12 items-end mb-10" data-reveal>
      <div class="md:col-span-7">
        <p class="eyebrow">§ Advocate directory</p>
        <h2 class="mt-4 font-display text-4xl md:text-5xl leading-[1.02] tracking-tight">
          Real advocates, real rolls, real signatures.
        </h2>
      </div>
      <div class="md:col-span-5 md:justify-self-end flex flex-wrap items-center gap-2">
        <span class="mono-label mr-1">Filter</span>
        <button type="button" class="chip">Any state</button>
        <button type="button" class="chip">Rentals</button>
        <button type="button" class="chip">Under 48 h</button>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal>
      {advocates.map((a) => (
        <article class="card p-6 flex flex-col">
          <div class="flex items-start gap-4">
            <span class="avatar avatar-ochre size-12 text-lg">{a.init}</span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-display text-[19px] leading-tight text-[color:var(--color-ink)]">{a.name}</h3>
                {a.status === "verified" ? (
                  <span class="badge badge-verified"><span class="badge-dot"></span>Verified</span>
                ) : (
                  <span class="badge badge-onboarding">Onboarding</span>
                )}
              </div>
              <p class="mt-1 text-[13px] text-[color:var(--color-ink-muted)]">{a.city} · <span class="font-mono">{a.roll}</span></p>
            </div>
          </div>

          <div class="mt-5 flex flex-wrap gap-1.5">
            {a.specs.map((sp) => <span class="chip">{sp}</span>)}
          </div>

          <dl class="mt-5 grid grid-cols-2 gap-3 pt-4 border-t border-[color:var(--color-hairline)]">
            <div>
              <dt class="mono-label">Files stamped</dt>
              <dd class="mt-1 font-display text-[22px] text-[color:var(--color-ink)]">{a.files}</dd>
            </div>
            <div>
              <dt class="mono-label">Stamp price</dt>
              <dd class="mt-1 font-display text-[22px] text-[color:var(--color-ink)]">{a.price}</dd>
            </div>
          </dl>

          <div class="mt-6 flex items-center gap-2">
            <a href={`${APP_URL}/intake`} class="btn btn-sm btn-ochre flex-1">Stamp with {a.name.split(" ")[0]}</a>
            <a href="/advisors/#waitlist" class="btn btn-sm btn-outline">Consult →</a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 pt-6 border-t border-[color:var(--color-hairline)]" data-reveal>
      <p class="text-[13px] text-[color:var(--color-ink-muted)]">
        Showing 6 of 42 advocates in onboarding · <span class="font-mono">Batch 03 opens Oct 2026</span>
      </p>
      <a href="/advisors/" class="text-[13px] font-medium underline decoration-[color:var(--color-ochre)] underline-offset-4">See the full directory →</a>
    </div>
  </section>

  <!-- HOW IT WORKS + SAMPLE NOTICE -->
  <section class="bg-[color:var(--color-ink)] text-[color:var(--color-paper)] relative overflow-hidden grain">
    <div class="relative max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-32">
      <div class="grid gap-14 md:grid-cols-12">
        <div class="md:col-span-5" data-reveal>
          <p class="eyebrow eyebrow-paper">§ How it works</p>
          <h2 class="mt-4 font-display text-4xl md:text-5xl leading-[1.02] tracking-tight text-[color:var(--color-paper)]">
            Four moves.<br />
            No email required for the first three.
          </h2>

          <ol class="mt-10 space-y-0 border-t border-[color:var(--color-hairline-dark)]">
            {steps.map((st) => (
              <li class="grid grid-cols-12 gap-4 py-5 border-b border-[color:var(--color-hairline-dark)]">
                <div class="col-span-2 font-mono text-[11px] tracking-[0.18em] text-[color:var(--color-ochre)]">§{st.n}</div>
                <div class="col-span-10">
                  <h3 class="font-display text-xl text-[color:var(--color-paper)] leading-tight">{st.t}</h3>
                  <p class="mt-1.5 text-[13.5px] text-[color:var(--color-paper-muted)] leading-relaxed">{st.d}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="md:col-span-7 md:pl-6" data-reveal>
          <div class="relative">
            <div class="absolute -top-3 -right-3 z-10 hidden md:block">
              <span class="badge" style="background:var(--color-ochre); color:var(--color-ink); border-color:var(--color-ochre);">Sample · redacted</span>
            </div>
            <div class="bg-[color:var(--color-paper)] text-[color:var(--color-ink)] shadow-2xl border border-[color:var(--color-hairline-2)] p-6 md:p-10">
              <div class="flex items-start justify-between pb-4 border-b border-[color:var(--color-ink)]">
                <div>
                  <p class="font-editorial text-2xl leading-none">LEGAL NOTICE</p>
                  <p class="mono-label mt-2">under §106, Transfer of Property Act, 1882 · §80 CPC</p>
                </div>
                <div class="text-right">
                  <p class="mono-label">Ref</p>
                  <p class="font-mono text-[13px] mt-1">RC-2026-09-2841</p>
                </div>
              </div>

              <div class="mt-6 space-y-4 text-[13.5px] leading-[1.7] text-[color:var(--color-ink)]">
                <p><span class="mono-label">To</span><br />Mr. [Landlord Name],<br />[Address of Landlord]</p>
                <p><span class="mono-label">From</span><br />[Tenant Name], through counsel,<br />[Property Address]</p>
                <p class="pt-2 border-t border-[color:var(--color-hairline)]">
                  <b>Sir / Madam,</b>
                </p>
                <p class="text-[color:var(--color-ink-muted)]">
                  Under instructions from and on behalf of my client, the tenant named above, I do hereby serve upon you the following notice under §106 of the Transfer of Property Act, 1882, read with §17 of the Karnataka Rent Act, 2001, in respect of the property let out under the tenancy agreement dated <span class="font-mono">[dd/mm/yyyy]</span>...
                </p>
                <p class="text-[color:var(--color-ink-muted)]">
                  You are hereby called upon to refund the security deposit of ₹<span class="font-mono">[amount]</span> together with statutory interest within <b>fifteen (15) days</b> of receipt of this notice, failing which my client shall be constrained to initiate appropriate proceedings before the Court of the Rent Controller, Bengaluru, at your risk as to costs and consequences.
                </p>
              </div>

              <div class="mt-8 pt-5 border-t border-dashed border-[color:var(--color-hairline-2)] flex items-end justify-between">
                <div>
                  <p class="mono-label">Signed & sealed by</p>
                  <p class="mt-2 font-editorial text-2xl italic text-[color:var(--color-ochre-2)]">Anushka R. Rao</p>
                  <p class="mono-label mt-1">Advocate · Bar Council of Karnataka · KA / 2014</p>
                </div>
                <div class="text-right">
                  <div class="inline-grid place-items-center size-16 rounded-full border-2 border-[color:var(--color-ochre)] text-[color:var(--color-ochre-2)]">
                    <div class="flex flex-col items-center leading-none">
                      <span class="font-editorial text-lg">R</span>
                      <span class="font-mono text-[7px] tracking-[0.24em] uppercase mt-0.5">STAMPED</span>
                    </div>
                  </div>
                  <p class="mono-label mt-2">2026 · MMXXVI</p>
                </div>
              </div>
            </div>
            <p class="mt-3 font-mono text-[11px] text-[color:var(--color-paper-muted)] tracking-[0.14em] uppercase">
              What lands in your dashboard 48 h after you request a stamp.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COVERAGE -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-28">
    <div class="grid gap-10 md:grid-cols-12 items-end mb-12" data-reveal>
      <div class="md:col-span-7">
        <p class="eyebrow">§ Coverage</p>
        <h2 class="mt-4 font-display text-4xl md:text-5xl leading-[1.02] tracking-tight">
          Ten states plus a national fallback.
        </h2>
      </div>
      <p class="md:col-span-5 md:justify-self-end max-w-md text-[color:var(--color-ink-muted)] leading-relaxed">
        If your state isn't listed, the draft uses the Consumer Protection Act 2019, the Indian Contract Act, and CPC §80 — statutes that apply anywhere in India.
      </p>
    </div>

    <div class="grid gap-0 sm:grid-cols-2 lg:grid-cols-5 border-t border-l border-[color:var(--color-hairline)]" data-reveal>
      {coverage.map((c) => (
        <div class="p-5 border-r border-b border-[color:var(--color-hairline)] bg-[color:var(--color-cream)]">
          <p class="font-display text-[19px] leading-tight text-[color:var(--color-ink)]">{c.st}</p>
          <p class="mt-2 mono-label leading-snug">{c.cities}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FOR ADVOCATES -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 pb-20 md:pb-28">
    <div class="card card-ink p-8 md:p-14 relative overflow-hidden grain" data-reveal>
      <div class="relative grid gap-8 md:grid-cols-12 items-center">
        <div class="md:col-span-8">
          <p class="eyebrow eyebrow-ochre">§ For advocates</p>
          <h2 class="mt-4 font-display text-3xl md:text-5xl leading-[1.02] tracking-tight text-[color:var(--color-paper)]">
            Get paid to <span class="text-[color:var(--color-ochre)]">redline</span> — not to draft from scratch.
          </h2>
          <p class="mt-5 max-w-2xl text-[15px] text-[color:var(--color-paper-muted)] leading-relaxed">
            Our agent produces the first draft. You review, verify, and sign the sealed notice on your letterhead. Files arrive pre-classified, pre-cited, and routed to the correct forum. Payout on delivery. No client acquisition, no drafting from scratch.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/advisors/#for-advocates" class="btn btn-ochre">Apply to join</a>
            <a href="/advisors/" class="btn btn-outline-paper">See how it works</a>
          </div>
        </div>
        <dl class="md:col-span-4 grid grid-cols-2 gap-6 md:gap-4">
          <div>
            <dt class="mono-label text-[color:var(--color-paper-muted)]">Per stamped file</dt>
