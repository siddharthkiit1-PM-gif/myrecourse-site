---
import Base from "../layouts/Base.astro";
import Seal from "../components/Seal.astro";

const APP_URL = "https://rental-recourse.vercel.app";

const principles = [
  {
    n: "I.",
    title: "Verbatim over generated.",
    body: "Statute text is retrieved from a curated corpus of ten state Rent Acts and national law. The model assembles; it does not invent citations. Every quoted section is checked before you see it.",
  },
  {
    n: "II.",
    title: "Deterministic where it matters.",
    body: "The forum recommendation is a hard-coded rule matrix. Same facts, same forum, every time — auditable end-to-end.",
  },
  {
    n: "III.",
    title: "Real people on the seal.",
    body: "The ₹499 stamp is not cosmetic. A Bar Council–enrolled advocate reads the draft, redlines it, and signs the sealed notice on their letterhead with their state roll number.",
  },
  {
    n: "IV.",
    title: "Minimum data, maximum privacy.",
    body: "The free draft requires no account and no email. Session data expires in 24 hours. The stamp step needs an email so the sealed PDF can reach you — nothing else.",
  },
  {
    n: "V.",
    title: "Free as the default.",
    body: "The draft is and will remain free. Marketplace services (stamp, filing, advisory) will always be strictly optional add-ons.",
  },
];

const chapters = [
  {
    n: "01",
    year: "Aug 2026",
    title: "The draft.",
    body: "Launched as a free tool. Five minutes on your phone, a legal notice with verbatim state-law citations, downloaded as PDF. No account. No email. Solo-built as a public-interest project.",
  },
  {
    n: "02",
    year: "Sep 2026",
    title: "The seal.",
    body: "The first Bar Council–enrolled advocates joined a private beta. ₹499 to redline the draft, sign, and stamp it onto their letterhead. Turnaround under 48 hours.",
  },
  {
    n: "03",
    year: "Q4 2026",
    title: "The directory.",
    body: "Advocate profiles open for browsing — locale, state, specialisation, Bar roll on file, availability. Book stamp requests to a specific advocate rather than the pool.",
  },
  {
    n: "04",
    year: "2027",
    title: "The rest of the shelf.",
    body: "Filing your notice by registered post on your behalf. General legal consulting and short retainers on tenancy, consumer, and contract matters. All through the same marketplace.",
  },
];
---

<Base
  title="About — Recourse"
  description="Why Recourse exists, who is building it, and the principles behind a marketplace of legal advisors for Indian tenants."
  headerVariant="paper"
>
  <!-- HERO -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 pt-16 md:pt-28 pb-12">
    <div class="grid gap-10 md:grid-cols-12 items-end">
      <div class="md:col-span-8">
        <p class="eyebrow rise" style="animation-delay:0ms">§ About</p>
        <h1 class="mt-6 font-display text-[46px] md:text-[80px] leading-[0.98] tracking-tight rise" style="animation-delay:60ms">
          A working tool, not a
          <span class="italic text-[color:var(--color-ochre)]">marketing site</span> pretending to be one.
        </h1>
      </div>
      <div class="md:col-span-4 flex md:justify-end rise" style="animation-delay:140ms">
        <Seal size={180} tone="ochre" />
      </div>
    </div>
  </section>

  <!-- OPENING ESSAY -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 py-10 md:py-16 border-t border-[color:var(--color-hairline)]">
    <div class="grid gap-10 md:grid-cols-12" data-reveal>
      <div class="md:col-span-4">
        <p class="eyebrow">Opening argument</p>
      </div>
      <div class="md:col-span-8 space-y-6 text-[18px] md:text-[19px] leading-[1.6] text-[color:var(--color-ink)]">
        <p class="first-letter:font-display first-letter:text-6xl first-letter:font-normal first-letter:float-left first-letter:leading-[0.85] first-letter:mr-2 first-letter:mt-1 first-letter:text-[color:var(--color-ochre)]">
          Recourse started with a simple observation. In India, the difference between a landlord who returns your deposit and one who does not is often a single piece of paper. A properly-worded, correctly-cited legal notice, sent by registered post, ends most of these conversations before they escalate.
        </p>
        <p>
          And yet almost no tenant sends one. Not because their case is weak — because the tool for producing that piece of paper has been priced, gatekept, and made confusing. Generic templates online are unpersuasive. A private advocate will draft one, at ₹500 to ₹2,000, over the course of a week. Free legal aid exists, and is slow.
        </p>
        <p>
          Recourse takes the middle path away entirely. Five minutes on your phone, a real notice with verbatim state-law citations, downloaded as PDF, free. And when the letter needs an advocate's name and letterhead on it — because some landlords only respect that — the same product hands you off, for ₹499, to a Bar Council–enrolled advocate on the marketplace, within forty-eight hours.
        </p>
        <p class="text-[color:var(--color-ink-muted)]">
          The rest of what we're building — filing, advisory, a browsable directory of advocates — follows from the same principle. Legal services in India cost too much because the two hardest things about them — retrieval and referral — are still done by hand. Recourse is the small, focused attempt to fix that, one product at a time.
        </p>
      </div>
    </div>
  </section>

  <!-- PRINCIPLES -->
  <section class="relative bg-[color:var(--color-ink)] text-[color:var(--color-paper)] grain overflow-hidden">
    <div class="relative max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-32">
      <div class="grid gap-12 md:grid-cols-12 items-start" data-reveal>
        <div class="md:col-span-4">
          <p class="eyebrow eyebrow-paper">§ Principles</p>
          <h2 class="mt-5 font-display text-4xl md:text-6xl leading-[1.0] tracking-tight">
            Five<br />
            <span class="italic text-[color:var(--color-ochre)]">non-negotiables.</span>
          </h2>
          <p class="mt-6 text-[color:var(--color-paper-muted)] leading-relaxed max-w-xs">
            Any feature that violates one of these does not ship. Any partner who cannot honour them does not join the marketplace.
          </p>
        </div>
        <ol class="md:col-span-8 divide-y divide-[color:var(--color-hairline-dark)] border-t border-[color:var(--color-hairline-dark)]">
          {principles.map((p) => (
            <li class="grid grid-cols-12 gap-4 py-7">
              <div class="col-span-2 md:col-span-1 font-display text-2xl text-[color:var(--color-ochre)] leading-none">{p.n}</div>
              <div class="col-span-10 md:col-span-11">
                <h3 class="font-display text-2xl md:text-3xl leading-tight text-[color:var(--color-paper)]">{p.title}</h3>
                <p class="mt-2 text-[15px] text-[color:var(--color-paper-muted)] leading-relaxed max-w-2xl">{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ROADMAP / CHAPTERS -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-32">
    <div class="grid gap-12 md:grid-cols-12" data-reveal>
      <div class="md:col-span-4">
        <p class="eyebrow">§ Chapters</p>
        <h2 class="mt-5 font-display text-4xl md:text-5xl leading-[1.02] tracking-tight">
          One shelf, four <span class="italic text-[color:var(--color-ochre)]">books</span>.
        </h2>
        <p class="mt-6 text-[color:var(--color-ink-muted)] leading-relaxed max-w-sm">
          The order matters. Each layer only opens after the previous one is stable in tenants' hands.
        </p>
      </div>
      <ol class="md:col-span-8 space-y-4">
        {chapters.map((c) => (
          <li class="grid grid-cols-12 gap-4 py-6 border-t border-[color:var(--color-hairline)]">
            <div class="col-span-2 md:col-span-1 font-mono text-[11px] tracking-[0.18em] text-[color:var(--color-ochre-2)]">§{c.n}</div>
            <div class="col-span-10 md:col-span-8">
              <h3 class="font-display text-2xl md:text-3xl leading-tight">{c.title}</h3>
              <p class="mt-2 text-[15px] text-[color:var(--color-ink-muted)] leading-relaxed">{c.body}</p>
            </div>
            <div class="col-span-12 md:col-span-3 md:text-right font-mono text-[11px] tracking-[0.14em] uppercase text-[color:var(--color-ink-faint)]">
              {c.year}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TEAM + CONTACT -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 pb-24">
    <div class="grid gap-10 md:grid-cols-12" data-reveal>
      <div class="md:col-span-6 p-8 md:p-12 border border-[color:var(--color-hairline)] bg-[color:var(--color-cream)]">
        <p class="eyebrow">The team</p>
        <p class="mt-5 font-display text-3xl md:text-4xl leading-[1.05] tracking-tight">
          Solo-built. Advocates on the panel.
        </p>
        <p class="mt-4 text-[15px] text-[color:var(--color-ink-muted)] leading-relaxed">
          Product, engineering, and copy by one person. Legal work by
          Bar Council–enrolled advocates on the marketplace, all named on the
          documents they sign. Source is public at
          <a class="underline decoration-[color:var(--color-ochre)] underline-offset-4" rel="noopener" href="https://github.com/siddharthkiit1-PM-gif/rental-recourse">siddharthkiit1-PM-gif/rental-recourse</a>.
        </p>
      </div>
      <div class="md:col-span-6 p-8 md:p-12 border border-[color:var(--color-hairline)] bg-[color:var(--color-cream)]">
        <p class="eyebrow">Say hello</p>
        <p class="mt-5 font-display text-3xl md:text-4xl leading-[1.05] tracking-tight">
          Feedback, corrections, press, partnerships.
        </p>
        <p class="mt-4 text-[15px] text-[color:var(--color-ink-muted)] leading-relaxed">
          A person reads every email.
          <a class="underline decoration-[color:var(--color-ochre)] underline-offset-4 block mt-2 font-mono text-[13px]" href="mailto:hello@myrecourse.in">hello@myrecourse.in</a>
        </p>
      </div>
    </div>

    <div class="mt-12 paper-texture border border-[color:var(--color-hairline)] p-8 md:p-14 flex flex-col md:flex-row md:items-end md:justify-between gap-8" data-reveal>
      <div>
        <p class="eyebrow">§ Try it</p>
        <h3 class="mt-4 font-display text-3xl md:text-5xl leading-[1.02] tracking-tight max-w-xl">
          The best introduction is the <span class="italic text-[color:var(--color-ochre)]">product</span> itself.
        </h3>
      </div>
      <a href={`${APP_URL}/intake`} class="shrink-0 inline-flex items-center gap-2 h-12 px-6 bg-[color:var(--color-ink)] text-[color:var(--color-paper)] font-medium hover:opacity-90 transition-opacity">
        Draft my notice <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
