---
import Base from "../layouts/Base.astro";
import Seal from "../components/Seal.astro";

const APP_URL = "https://rental-recourse.vercel.app";

const draftSteps = [
  {
    n: "§01",
    title: "Intake",
    time: "~5 min",
    body: "Six short screens: what happened, tenant details, landlord details, property, evidence, jurisdiction. Anything you don't have is fine — the draft will note what's missing.",
  },
  {
    n: "§02",
    title: "Retrieval",
    time: "live",
    body: "The agent classifies the situation, routes to the correct forum, and pulls verbatim statute text from a curated corpus of ten state Rent Acts and national law. No hallucinated citations.",
  },
  {
    n: "§03",
    title: "Draft",
    time: "≈30 s",
    body: "You watch the draft compose itself. Sections, citations, dates, remedy demanded, deadline for compliance. Every citation is checked against the corpus before you see it.",
  },
  {
    n: "§04",
    title: "Edit & download",
    time: "your call",
    body: "Every field is inline-editable. Rewrite paragraphs, adjust dates, add facts. Export the PDF. Free, no signup.",
  },
];

const stampSteps = [
  {
    n: "§05",
    title: "Request stamp",
    time: "1 tap",
    body: "From the results page, tap Stamp. You pay ₹499 and hand over the draft. That's the whole transaction from your side.",
  },
  {
    n: "§06",
    title: "Advocate review",
    time: "within 48 h",
    body: "A Bar Council–enrolled advocate on the marketplace picks up your draft, redlines it, and confirms the citations against their own reading of your facts.",
  },
  {
    n: "§07",
    title: "Sign & seal",
    time: "same day",
    body: "The advocate signs the notice, applies their letterhead and roll number, and returns a stamped PDF into your Recourse dashboard.",
  },
  {
    n: "§08",
    title: "Send",
    time: "your call",
    body: "You send it. India Post registered A/D (with the receipt kept) or a signed email to the landlord and their agent. The stamped notice arrives on lawyer letterhead — landlords read it.",
  },
];

const guarantees = [
  { title: "Verbatim statute text", body: "Rent Act sections in your notice are retrieved, not generated. Section numbers and quoted text match the bare act." },
  { title: "Deterministic forum routing", body: "The choice of forum is decided by a hard-coded rule matrix, not a language model. Same facts, same forum, every time." },
  { title: "Citation verifier", body: "Every citation is checked against the corpus before the draft is shown. Hallucinated sections are rejected outright." },
  { title: "Advocate on the line", body: "The stamp isn't cosmetic. A Bar Council–enrolled advocate signs and takes professional responsibility for the sealed version." },
];
---

<Base
  title="How it works — Recourse"
  description="From tenant intake to Bar Council–stamped notice. Free draft in about 30 seconds; advocate-verified and sealed within 48 hours for ₹499."
  headerVariant="paper"
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="max-w-[1240px] mx-auto px-5 md:px-10 pt-16 md:pt-28 pb-16 md:pb-24">
      <div class="grid gap-10 md:grid-cols-12 items-end">
        <div class="md:col-span-8">
          <p class="eyebrow rise" style="animation-delay:0ms">§ How it works</p>
          <h1 class="mt-6 font-display text-[46px] md:text-[76px] leading-[0.98] tracking-tight rise" style="animation-delay:60ms">
            An agent that behaves like a
            <span class="italic text-[color:var(--color-ochre)]">paralegal</span>,
            not a chatbot.
          </h1>
          <p class="mt-8 max-w-2xl text-[17px] md:text-lg text-[color:var(--color-ink-muted)] leading-relaxed rise" style="animation-delay:140ms">
            Two layers, one product. The <em>draft</em> takes about thirty
            seconds and costs nothing. The <em>stamp</em> — a Bar Council
            advocate reviewing, redlining, signing — takes forty-eight hours
            and costs ₹499. Either half stands alone.
          </p>
        </div>
        <div class="md:col-span-4 flex md:justify-end rise" style="animation-delay:220ms">
          <Seal size={180} tone="ochre" />
        </div>
      </div>

      <div class="mt-14 md:mt-20 pt-6 border-t border-[color:var(--color-hairline)] grid grid-cols-3 gap-6 md:gap-10">
        <div>
          <p class="eyebrow">Layer one</p>
          <p class="mt-3 font-display text-3xl md:text-4xl">Draft</p>
          <p class="mt-1 text-sm text-[color:var(--color-ink-muted)]">Free · ~30 s</p>
        </div>
        <div>
          <p class="eyebrow">Layer two</p>
          <p class="mt-3 font-display text-3xl md:text-4xl">Stamp</p>
          <p class="mt-1 text-sm text-[color:var(--color-ink-muted)]">₹499 · 48 h</p>
        </div>
        <div>
          <p class="eyebrow">Coverage</p>
          <p class="mt-3 font-display text-3xl md:text-4xl">10 <span class="text-[color:var(--color-ink-faint)]">states</span></p>
          <p class="mt-1 text-sm text-[color:var(--color-ink-muted)]">+ national fallback</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LAYER 1 -->
  <section class="relative bg-[color:var(--color-cream)] border-y border-[color:var(--color-hairline)]">
    <div class="max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-28">
      <div class="grid gap-12 md:grid-cols-12" data-reveal>
        <div class="md:col-span-4">
          <p class="eyebrow">Layer one · Free</p>
          <h2 class="mt-5 font-display text-4xl md:text-5xl leading-[1.02] tracking-tight">
            The <span class="italic text-[color:var(--color-ochre)]">draft</span>, in four steps.
          </h2>
          <p class="mt-6 text-[color:var(--color-ink-muted)] leading-relaxed">
            You never leave the tab. Every stage runs in front of you.
          </p>
        </div>
        <ol class="md:col-span-8 space-y-4">
          {draftSteps.map((s, i) => (
            <li class="grid grid-cols-12 gap-4 py-6 border-t border-[color:var(--color-hairline)]" style={`transition-delay:${i * 60}ms`}>
              <div class="col-span-2 md:col-span-1 font-mono text-[11px] tracking-[0.18em] text-[color:var(--color-ochre-2)]">{s.n}</div>
              <div class="col-span-10 md:col-span-8">
                <h3 class="font-display text-2xl md:text-3xl leading-tight">{s.title}</h3>
                <p class="mt-2 text-[15px] text-[color:var(--color-ink-muted)] leading-relaxed">{s.body}</p>
              </div>
              <div class="col-span-12 md:col-span-3 md:text-right font-mono text-[11px] tracking-[0.14em] uppercase text-[color:var(--color-ink-faint)]">
                {s.time}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- LAYER 2 — INK -->
  <section class="relative overflow-hidden bg-[color:var(--color-ink)] text-[color:var(--color-paper)] grain">
    <div class="relative max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-32">
      <div class="grid gap-12 md:grid-cols-12" data-reveal>
        <div class="md:col-span-4">
          <p class="eyebrow eyebrow-paper">Layer two · ₹499</p>
          <h2 class="mt-5 font-display text-4xl md:text-5xl leading-[1.02] tracking-tight">
            The <span class="italic text-[color:var(--color-ochre)]">stamp</span>, in four more.
          </h2>
          <p class="mt-6 text-[color:var(--color-paper-muted)] leading-relaxed">
            A Bar Council–enrolled advocate joins your file, redlines the
            draft, and signs a sealed version onto their letterhead.
          </p>
          <div class="mt-10 hidden md:block">
            <Seal size={200} tone="ochre" />
          </div>
        </div>
        <ol class="md:col-span-8 space-y-0">
          {stampSteps.map((s) => (
            <li class="grid grid-cols-12 gap-4 py-6 border-t border-[color:var(--color-hairline-dark)]">
              <div class="col-span-2 md:col-span-1 font-mono text-[11px] tracking-[0.18em] text-[color:var(--color-ochre)]">{s.n}</div>
              <div class="col-span-10 md:col-span-8">
                <h3 class="font-display text-2xl md:text-3xl leading-tight text-[color:var(--color-paper)]">{s.title}</h3>
                <p class="mt-2 text-[15px] text-[color:var(--color-paper-muted)] leading-relaxed">{s.body}</p>
              </div>
              <div class="col-span-12 md:col-span-3 md:text-right font-mono text-[11px] tracking-[0.14em] uppercase text-[color:var(--color-paper-muted)]">
                {s.time}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- GUARANTEES -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-12" data-reveal>
      <div class="md:col-span-4">
        <p class="eyebrow">What holds it up</p>
        <h2 class="mt-5 font-display text-4xl md:text-5xl leading-[1.02] tracking-tight">
          A pretty notice with a fake citation is worse than none at all.
        </h2>
      </div>
      <div class="md:col-span-8 grid gap-6 md:grid-cols-2">
        {guarantees.map((g) => (
          <article class="p-6 border-l-2 border-[color:var(--color-ochre)] bg-[color:var(--color-cream)]">
            <h3 class="font-display text-2xl leading-tight">{g.title}</h3>
            <p class="mt-3 text-[15px] text-[color:var(--color-ink-muted)] leading-relaxed">{g.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-[1240px] mx-auto px-5 md:px-10 pb-24">
    <div class="paper-texture border border-[color:var(--color-hairline)] p-8 md:p-14 flex flex-col md:flex-row md:items-end md:justify-between gap-8" data-reveal>
      <div>
        <p class="eyebrow">Start</p>
        <h3 class="mt-4 font-display text-3xl md:text-5xl leading-[1.02] tracking-tight max-w-xl">
          Draft first. Decide about the <span class="italic text-[color:var(--color-ochre)]">stamp</span> on the results page.
        </h3>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a href={`${APP_URL}/intake`} class="inline-flex items-center justify-center gap-2 h-12 px-6 bg-[color:var(--color-ink)] text-[color:var(--color-paper)] font-medium hover:opacity-90 transition-opacity">
          Draft — free <span aria-hidden="true">→</span>
        </a>
        <a href="/notice/#stamp" class="inline-flex items-center justify-center gap-2 h-12 px-6 border border-[color:var(--color-ink)] text-[color:var(--color-ink)] font-medium hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-paper)] transition-colors">
          Read about the stamp
        </a>
      </div>
    </div>
  </section>
</Base>
