---
import Base from "../layouts/Base.astro";

const APP_URL = "https://rental-recourse.vercel.app";

const journey = [
  {
    n: "01",
    title: "Landing",
    body: "You arrive on the site and pick your state. If your state isn't in our list of dedicated Rent Acts, we fall back to national statutes that apply anywhere in India.",
  },
  {
    n: "02",
    title: "Intake (~5 min)",
    body: "Six short screens: what happened, tenant details, landlord details, property, evidence you have, jurisdiction. Everything is optional if you don't have it \u2014 the draft will note what's missing.",
  },
  {
    n: "03",
    title: "Processing (live)",
    body: "You watch an agent stream: classify the situation, route to the correct forum, retrieve verbatim statute text, verify citations, draft the notice. Roughly 30 seconds.",
  },
  {
    n: "04",
    title: "Result",
    body: "You see the legal notice draft, a forum recommendation (police, RERA, consumer commission, rent controller, civil suit, or demand notice), and an evidence checklist.",
  },
  {
    n: "05",
    title: "Edit and download",
    body: "Inline edits, PDF export, one-tap rating. From there, you send the notice yourself \u2014 by registered post, email, or through an advocate.",
  },
];

const guarantees = [
  { title: "Verbatim statute text", body: "The Rent Act sections in your notice are pulled from a curated corpus, not generated by an LLM. Section numbers and quoted text match the bare act." },
  { title: "Deterministic forum routing", body: "The choice of forum is decided by a hard-coded rule matrix, not a language model. It's auditable and always the same for the same inputs." },
  { title: "Citation verifier", body: "Every citation is checked against the corpus before the draft is shown to you. Hallucinated sections are rejected outright." },
  { title: "Safety filter", body: "A forbidden-terms filter blocks fabricated attorney claims and promises-of-outcome from appearing in your notice." },
];

const doesnt = [
  "Book you a lawyer consultation",
  "File the notice or case on your behalf",
  "Track court dates or follow-ups",
  "Store your data beyond 24 hours",
  "Require an account, email, or payment",
];
---

<Base
  title="How it works \u2014 Recourse"
  description="Five steps, about five minutes. Recourse turns a rental dispute into a filing-ready legal notice using verbatim statute text and deterministic forum routing."
>
  <section class="max-w-4xl mx-auto px-5 md:px-8 pt-14 md:pt-24 pb-8">
    <p class="text-xs uppercase tracking-[0.14em] text-[color:var(--color-ink-faint)]">How it works</p>
    <h1 class="mt-3 font-serif text-4xl md:text-5xl tracking-tight leading-[1.05]">
      An agent that behaves like a paralegal, not a chatbot.
    </h1>
    <p class="mt-6 text-lg text-[color:var(--color-ink-muted)] leading-relaxed max-w-2xl">
      Recourse is built around a single question: <em>can a piece of software
      produce a legal notice a landlord actually respects?</em> The answer we
      built for is yes &mdash; if the citations are real, the forum choice is
      correct, and the tone is unmistakably legal.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-5 md:px-8 pt-8 pb-8">
    <ol class="space-y-4">
      {
        journey.map((step) => (
          <li class="rounded-lg border border-[color:var(--color-hairline)] bg-[color:var(--color-surface)] p-6 md:p-8">
            <div class="flex items-baseline gap-4">
              <span class="font-serif text-[color:var(--color-accent)] text-lg font-medium">{step.n}</span>
              <h2 class="font-medium text-xl">{step.title}</h2>
            </div>
            <p class="mt-3 text-[color:var(--color-ink-muted)] leading-relaxed">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="max-w-4xl mx-auto px-5 md:px-8 pt-12 md:pt-20">
    <h2 class="font-serif text-3xl tracking-tight">What makes the draft trustworthy</h2>
    <p class="mt-4 text-[color:var(--color-ink-muted)] leading-relaxed max-w-2xl">
      A pretty-looking notice with a fake citation is worse than no notice at
      all. Every design decision below exists to prevent that.
    </p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        guarantees.map((g) => (
          <article class="rounded-lg border border-[color:var(--color-hairline)] bg-[color:var(--color-panel)]/60 p-6">
            <h3 class="font-medium text-lg">{g.title}</h3>
            <p class="mt-2 text-[15px] text-[color:var(--color-ink-muted)] leading-relaxed">{g.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-5 md:px-8 pt-16 md:pt-24">
    <h2 class="font-serif text-3xl tracking-tight">What Recourse deliberately doesn&rsquo;t do</h2>
    <p class="mt-4 text-[color:var(--color-ink-muted)] leading-relaxed max-w-2xl">
      A short list, because the boundaries are the product.
    </p>
    <ul class="mt-8 grid gap-3">
      {
        doesnt.map((d) => (
          <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-ink)]">
            <span aria-hidden="true" class="mt-2 size-1.5 rounded-full bg-[color:var(--color-ink-faint)] shrink-0"></span>
            <span>{d}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="max-w-4xl mx-auto px-5 md:px-8 pt-16 md:pt-24">
    <div class="rounded-2xl border border-[color:var(--color-hairline)] bg-[color:var(--color-panel)] p-8 md:p-12 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <h3 class="font-serif text-2xl md:text-3xl tracking-tight">Ready to see it?</h3>
        <p class="mt-2 text-[color:var(--color-ink-muted)]">Five minutes, no signup.</p>
      </div>
      <a
        href={`${APP_URL}/intake`}
        class="inline-flex items-center gap-2 h-11 px-6 rounded-md bg-[color:var(--color-ink)] text-[color:var(--color-bg)] font-medium hover:opacity-90 transition-opacity self-start md:self-auto"
      >
        Draft my notice
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
