---
interface Props {
  currentPath?: string;
  variant?: "paper" | "ink";
}
const { currentPath = "", variant = "paper" } = Astro.props;

const nav = [
  { href: "/advisors/", label: "Legal advisors" },
  { href: "/notice/", label: "The notice" },
  { href: "/how-it-works/", label: "How it works" },
  { href: "/faq/", label: "Pricing & FAQ" },
];

const APP_URL = "https://rental-recourse.vercel.app";

const isInk = variant === "ink";
---

<header
  class:list={[
    "sticky top-0 z-40 border-b backdrop-blur-md",
    isInk
      ? "bg-[color:var(--color-ink)]/80 border-[color:var(--color-hairline-dark)] text-[color:var(--color-canvas)]"
      : "bg-[color:var(--color-canvas)]/85 border-[color:var(--color-hairline)] text-[color:var(--color-ink)]",
  ]}
>
  <div class="max-w-[1240px] mx-auto px-5 md:px-10 h-16 md:h-[68px] flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 font-medium tracking-tight">
      <span
        class:list={[
          "inline-grid place-items-center size-8 rounded-lg font-display text-[16px] leading-none border",
          isInk
            ? "border-[color:var(--color-rust)] text-[color:var(--color-rust)] bg-[color:var(--color-ink-2)]"
            : "border-[color:var(--color-ink)] text-[color:var(--color-ink)] bg-[color:var(--color-cream)]",
        ]}
        aria-hidden="true"
      >R</span>
      <span class="font-display text-[21px] leading-none tracking-[-0.02em]">Recourse</span>
    </a>

    <nav class="hidden md:flex items-center gap-1 text-[13.5px]">
      {
        nav.map((item) => {
          const active = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "px-3 py-1.5 rounded-full transition-colors",
                isInk
                  ? active
                    ? "text-[color:var(--color-canvas)] bg-[color:var(--color-ink-3)]"
                    : "text-[color:var(--color-canvas-muted)] hover:text-[color:var(--color-canvas)]"
                  : active
                    ? "text-[color:var(--color-ink)] bg-[color:var(--color-canvas-2)]"
                    : "text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-ink)]",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/advisors/#waitlist"
        class:list={[
          "hidden md:inline-flex items-center h-9 px-4 text-[13px] rounded-full border transition-colors",
          isInk
            ? "border-[color:var(--color-hairline-dark-2)] text-[color:var(--color-canvas)] hover:bg-[color:var(--color-ink-3)]"
            : "border-[color:var(--color-hairline-2)] text-[color:var(--color-ink)] hover:bg-[color:var(--color-canvas-2)]",
        ]}
      >
        Waitlist
      </a>
      <a
        href={`${APP_URL}/intake`}
        class:list={[
          "inline-flex items-center gap-1.5 h-9 md:h-10 px-4 rounded-full text-[13.5px] font-medium transition-colors",
          isInk
            ? "bg-[color:var(--color-rust)] text-[color:var(--color-canvas)] hover:bg-[color:var(--color-rust-2)]"
            : "bg-[color:var(--color-ink)] text-[color:var(--color-canvas)] hover:bg-[color:var(--color-rust-3)]",
        ]}
      >
        Draft a notice
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <details
    class:list={[
      "md:hidden border-t",
      isInk ? "border-[color:var(--color-hairline-dark)]" : "border-[color:var(--color-hairline)]",
    ]}
  >
    <summary class="list-none px-5 py-3 text-sm cursor-pointer select-none opacity-80">
      Menu
    </summary>
    <nav class="px-5 pb-4 flex flex-col gap-2.5 text-sm">
      {nav.map((item) => <a href={item.href} class="py-1">{item.label}</a>)}
      <a href="/advisors/#waitlist" class="py-1">Waitlist</a>
    </nav>
  </details>
</header>
