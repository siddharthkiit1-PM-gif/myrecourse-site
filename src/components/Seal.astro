---
interface Props {
  size?: number;
  tone?: "ochre" | "ink" | "paper";
  spin?: boolean;
  label?: string;
}
const {
  size = 140,
  tone = "ochre",
  spin = true,
  label = "VERIFIED \u00B7 STAMPED \u00B7 RECOURSE \u00B7 MMXXVI \u00B7 ",
} = Astro.props;

const fill =
  tone === "ochre"
    ? "var(--color-ochre)"
    : tone === "ink"
      ? "var(--color-ink)"
      : "var(--color-paper)";
const stroke =
  tone === "ochre"
    ? "var(--color-ochre)"
    : tone === "ink"
      ? "var(--color-ink)"
      : "var(--color-paper)";
const contrast =
  tone === "paper" ? "var(--color-ink)" : "var(--color-paper)";

const id = `seal-path-${Math.random().toString(36).slice(2, 8)}`;
const repeated = (label + label + label).slice(0, 120);
---

<div
  class="relative inline-grid place-items-center"
  style={`width:${size}px;height:${size}px;`}
>
  <svg
    class:list={["absolute inset-0", spin && "seal-spin"]}
    viewBox="0 0 200 200"
    fill="none"
    aria-hidden="true"
  >
    <defs>
      <path
        id={id}
        d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"
      />
    </defs>
    <circle cx="100" cy="100" r="97" stroke={stroke} stroke-width="1" />
    <circle cx="100" cy="100" r="72" stroke={stroke} stroke-width="1" stroke-dasharray="2 4" opacity="0.6" />
    <text style={`font-family: var(--font-mono); font-size: 10.2px; letter-spacing: 0.24em; fill: ${stroke};`}>
      <textPath href={`#${id}`}>{repeated}</textPath>
    </text>
  </svg>
  <div class="relative flex flex-col items-center gap-0.5" style={`color:${stroke}`}>
    <span class="font-display text-3xl leading-none" style={`color:${stroke}`}>R</span>
    <span class="text-[8px] tracking-[0.28em] font-mono uppercase" style={`color:${stroke}`}>Recourse</span>
  </div>
</div>
